<%- include('../partials/head') %>
<div class="page-heading"><div><span class="eyebrow">HÀNH TRÌNH HỌC TẬP</span><h1>Lịch sử làm bài</h1><p>Tất cả lượt thi và kết quả của bạn.</p></div><a href="/exams" class="btn btn-primary">Chọn đề thi</a></div>
<section class="panel table-panel"><div class="panel-heading"><h2>Bài làm của bạn</h2><span class="count-badge"><%= total %> lượt</span></div><% if (!attempts.length) { %><%- include('../partials/empty', {heading:'Chưa có bài làm', description:'Chọn một đề thi để bắt đầu ghi nhận tiến bộ của bạn.'}) %><% } else { %><div class="table-responsive"><table class="table"><thead><tr><th>Đề thi</th><th>Thời gian bắt đầu</th><th>Trạng thái</th><th>Số câu đúng</th><th>Điểm / 10</th><th></th></tr></thead><tbody><% for (const a of attempts) { %><tr><td class="table-title"><%= a.exam_title %></td><td><%= formatDate(a.started_at) %></td><td><span class="badge-soft <%= a.status === 'in_progress' ? 'warning' : '' %>"><%= statusText(a.status) %></span></td><td><%= a.correct_count ?? '—' %> / <%= a.total_questions %></td><td><strong class="score"><%= scoreText(a.score) %></strong></td><td><a href="/attempts/<%= a.id %><%= a.status === 'in_progress' ? '' : '/result' %>"><%= a.status === 'in_progress' ? 'Tiếp tục' : 'Chi tiết' %></a></td></tr><% } %></tbody></table></div><% } %></section>
<nav class="pagination-bar" aria-label="Phân trang"><% if (page > 1) { %><a class="btn btn-outline-secondary" href="?page=<%= page-1 %>">Trang trước</a><% } %><span>Trang <%= page %> / <%= Math.max(1,Math.ceil(total/20)) %></span><% if (page*20 < total) { %><a class="btn btn-outline-secondary" href="?page=<%= page+1 %>">Trang sau</a><% } %></nav>
<%- include('../partials/foot') %>
