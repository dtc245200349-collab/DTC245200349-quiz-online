<%- include('../partials/head') %>
<div class="page-heading"><div><span class="eyebrow">BÀI THI ĐÃ HOÀN THÀNH</span><h1>Kết quả bài thi</h1><p><%= attempt.exam_title %> · <%= student.name %></p></div><a class="btn btn-outline-primary" href="<%= user.role === 'admin' ? '/admin/results' : '/history' %>">Xem lịch sử kết quả</a></div>
<section class="result-banner"><div class="result-score"><strong><%= scoreText(attempt.score) %></strong><span>/ 10 điểm</span></div><div><h2><%= Number(attempt.score) >= 5 ? 'Bạn đã hoàn thành tốt bài thi!' : 'Tiếp tục ôn tập để tiến bộ hơn' %></h2><p>Đúng <strong><%= attempt.correct_count %>/<%= attempt.total_questions %></strong> câu · <%= statusText(attempt.status) %></p><span>Nộp lúc <%= formatDate(attempt.submitted_at) %></span></div></section>
<div class="section-toolbar"><h2>Đáp án & giải thích</h2><span class="text-secondary">Xem lại để hiểu rõ hơn</span></div>
<% for (const answer of answers) { %><section class="question-card result-question"><div class="result-question-heading"><span class="question-number">Câu <%= answer.position %></span><span class="badge-soft <%= answer.is_correct ? '' : 'danger' %>"><%= answer.is_correct ? 'Chính xác' : (answer.selected_option ? 'Chưa chính xác' : 'Chưa trả lời') %></span></div><h3 class="question-text preserve"><%= answer.question_content %></h3><div class="options-list"><% for (const letter of ['A','B','C','D']) { %><div class="answer-option result-option <%= answer.correct_option === letter ? 'correct' : (answer.selected_option === letter ? 'incorrect' : '') %>"><span class="option-letter"><%= letter %></span><span><%= answer['option_' + letter.toLowerCase()] %></span><% if (answer.correct_option === letter) { %><small>Đáp án đúng</small><% } else if (answer.selected_option === letter) { %><small>Bạn đã chọn</small><% } %></div><% } %></div><div class="explanation"><strong>Bạn chọn: <%= answer.selected_option || 'Chưa trả lời' %> · Đáp án: <%= answer.correct_option %></strong><% if (answer.explanation) { %><p class="preserve"><%= answer.explanation %></p><% } %></div></section><% } %>
<%- include('../partials/foot') %>
