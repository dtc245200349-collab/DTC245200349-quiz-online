<%- include('../partials/head') %>
<div class="page-heading"><div><span class="eyebrow">SẴN SÀNG CHINH PHỤC KIẾN THỨC</span><h1>Đề thi của bạn</h1><p>Chọn một đề thi và bắt đầu thử sức hôm nay.</p></div><a class="btn btn-outline-primary" href="/history">Xem lịch sử</a></div>
<div class="stats-grid three"><div class="stat-card"><span>Bài thi đã hoàn thành</span><strong><%= stats.completed %><small>bài thi</small></strong></div><div class="stat-card"><span>Điểm trung bình</span><strong><%= scoreText(stats.average) %><small>/ 10</small></strong></div><div class="stat-card accent"><span>Điểm cao nhất</span><strong><%= scoreText(stats.best) %><small>/ 10</small></strong></div></div>
<div class="section-toolbar"><h2>Đề thi đang mở <span class="count-badge"><%= exams.length %></span></h2><form class="search-form" action="/exams"><label for="search" class="visually-hidden">Tìm đề thi</label><input class="form-control" id="search" name="q" value="<%= q %>" placeholder="Tìm tên đề thi…" maxlength="100"><button class="btn btn-outline-primary">Tìm kiếm</button></form></div>
<% if (!exams.length) { %><%- include('../partials/empty', {heading:'Chưa có đề thi phù hợp', description:'Thử từ khóa khác hoặc quay lại khi quản trị viên mở đề thi.'}) %><% } %>
<div class="exam-grid"><% for (const exam of exams) { %>
  <article class="exam-card"><div class="exam-card-top"><span class="exam-icon" aria-hidden="true">▤</span><span class="badge-soft <%= exam.active_attempt ? 'warning' : '' %>"><%= exam.active_attempt ? 'Đang làm bài' : 'Đang mở' %></span></div><h3><a href="/exams/<%= exam.id %>"><%= exam.title %></a></h3><p class="exam-description"><%= exam.description %></p><div class="exam-meta"><span>◷ <%= exam.duration_minutes %> phút</span><span>▤ <%= exam.question_count %> câu hỏi</span></div><a class="btn <%= exam.active_attempt ? 'btn-primary' : 'btn-outline-primary' %> w-100" href="<%= exam.active_attempt ? '/attempts/' + exam.active_attempt : '/exams/' + exam.id %>"><%= exam.active_attempt ? 'Tiếp tục làm bài' : 'Xem đề thi' %></a></article>
<% } %></div>
<%- include('../partials/foot') %>
