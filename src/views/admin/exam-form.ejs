<%- include('../partials/head') %>
<a class="back-link" href="/admin/exams">Quản lý đề thi</a><div class="page-heading"><div><h1><%= title %></h1><p>Thiết lập bài thi và chọn các câu hỏi muốn sử dụng.</p></div></div>
<% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
<form action="/admin/exams/<%= exam.id ? exam.id + '/edit' : 'new' %>" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="detail-grid"><section class="panel"><h2>Thông tin đề thi</h2><div class="mb-3"><label class="form-label" for="title">Tên đề thi</label><input class="form-control" id="title" name="title" value="<%= exam.title || '' %>" minlength="3" maxlength="200" required></div><div class="mb-3"><label class="form-label" for="description">Mô tả</label><textarea class="form-control" id="description" name="description" rows="3" maxlength="5000"><%= exam.description || '' %></textarea></div><div class="row"><div class="col-sm-6 mb-3"><label class="form-label" for="duration_minutes">Thời gian (phút)</label><input class="form-control" id="duration_minutes" name="duration_minutes" type="number" min="1" max="180" value="<%= exam.duration_minutes %>" required></div><div class="col-sm-6 mb-3"><label class="form-label" for="question_count">Số lượng câu hỏi</label><input class="form-control" id="question_count" name="question_count" type="number" min="1" max="100" value="<%= exam.question_count %>" required></div></div><label class="form-check"><input class="form-check-input" type="checkbox" name="is_published" value="1" <%= exam.is_published ? 'checked' : '' %>><span class="form-check-label">Mở đề thi cho sinh viên</span></label></section><aside class="panel"><h2>Xuất bản đề thi</h2><p class="text-secondary">Chọn đúng số câu đã thiết lập. Thứ tự câu hỏi theo thứ tự trong ngân hàng.</p><div class="info-note mb-4">Nếu chỉnh sửa đề, các lượt thi đã bắt đầu vẫn giữ nội dung và thời gian ban đầu.</div><button class="btn btn-primary w-100 mb-2">Lưu đề thi</button><a href="/admin/exams" class="btn btn-outline-secondary w-100">Hủy</a></aside></div><section class="panel mt-4"><div class="section-toolbar"><h2>Chọn câu hỏi</h2><span id="selection-count" class="badge-soft">Đã chọn <%= selected.length %> câu</span></div><label for="question-filter" class="visually-hidden">Lọc câu hỏi</label><input class="form-control mb-3" id="question-filter" placeholder="Lọc nội dung hoặc chủ đề…" type="search"><div class="question-picker"><% for (const q of questions) { %><label class="picker-row" data-search="<%= (q.content + ' ' + q.category).toLowerCase() %>"><input class="form-check-input" type="checkbox" name="question_ids" value="<%= q.id %>" <%= selected.includes(q.id) ? 'checked' : '' %>><span><small>#<%= q.id %> · <%= q.category %></small><%= q.content %></span></label><% } %></div><% if (!questions.length) { %><p>Chưa có câu hỏi. <a href="/admin/questions/new">Thêm câu hỏi trước khi tạo đề.</a></p><% } %></section></form>
<%- include('../partials/foot') %>
