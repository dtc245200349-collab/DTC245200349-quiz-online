<%- include('../partials/head') %>
<div class="page-heading"><div><span class="eyebrow">TỔ CHỨC ĐÁNH GIÁ</span><h1>Quản lý đề thi</h1><p>Tạo đề từ ngân hàng câu hỏi và mở cho sinh viên làm bài.</p></div><a class="btn btn-primary" href="/admin/exams/new">+ Tạo đề thi</a></div>
<section class="panel table-panel"><div class="table-responsive"><table class="table"><thead><tr><th>Đề thi</th><th>Thời gian</th><th>Số câu</th><th>Lượt thi</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><% for (const e of exams) { %><tr><td class="table-title"><%= e.title %></td><td><%= e.duration_minutes %> phút</td><td><%= e.question_count %></td><td><a href="/admin/results?exam_id=<%= e.id %>"><%= e.attempts %> lượt</a></td><td><span class="badge-soft <%= e.is_published ? '' : 'neutral' %>"><%= e.is_published ? 'Đang mở' : 'Bản nháp' %></span></td><td><div class="table-actions"><a class="btn btn-sm btn-outline-primary" href="/admin/exams/<%= e.id %>/edit">Sửa</a><form action="/admin/exams/<%= e.id %>/delete" method="post" data-confirm="Lưu trữ đề thi này? Bài đang làm và kết quả cũ vẫn được giữ lại."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-outline-danger">Lưu trữ</button></form></div></td></tr><% } %></tbody></table></div><% if (!exams.length) { %><%- include('../partials/empty', {heading:'Chưa có đề thi',description:'Tạo đề thi đầu tiên từ ngân hàng câu hỏi.'}) %><% } %></section>
<%- include('../partials/foot') %>
