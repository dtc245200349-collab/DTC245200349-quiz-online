<%- include('../partials/head') %>
<a class="back-link" href="/admin/questions">Ngân hàng câu hỏi</a><div class="page-heading"><div><h1><%= title %></h1><p>Mỗi câu hỏi gồm bốn phương án và một đáp án đúng.</p></div></div>
<% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
<form class="panel editor-form" action="/admin/questions/<%= question.id ? question.id + '/edit' : 'new' %>" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="mb-4"><label class="form-label" for="content">Nội dung câu hỏi <span class="required">*</span></label><textarea class="form-control" id="content" name="content" rows="4" minlength="5" maxlength="5000" required><%= question.content || '' %></textarea></div><div class="row"><% for (const letter of ['a','b','c','d']) { %><div class="col-md-6 mb-3"><label class="form-label" for="option_<%= letter %>">Phương án <%= letter.toUpperCase() %> <span class="required">*</span></label><textarea class="form-control" id="option_<%= letter %>" name="option_<%= letter %>" rows="2" maxlength="1000" required><%= question['option_' + letter] || '' %></textarea></div><% } %></div><div class="row"><div class="col-md-6 mb-3"><label class="form-label" for="correct_option">Đáp án đúng</label><select class="form-select" name="correct_option" id="correct_option" required><% for (const letter of ['A','B','C','D']) { %><option value="<%= letter %>" <%= question.correct_option === letter ? 'selected' : '' %>>Phương án <%= letter %></option><% } %></select></div><div class="col-md-6 mb-3"><label class="form-label" for="category">Chủ đề</label><input class="form-control" name="category" id="category" value="<%= question.category || '' %>" placeholder="Ví dụ: Docker, MySQL, Bảo mật" maxlength="100" required></div></div><div class="mb-4"><label class="form-label" for="explanation">Giải thích đáp án</label><textarea class="form-control" name="explanation" id="explanation" rows="3" maxlength="5000"><%= question.explanation || '' %></textarea><div class="form-text">Sinh viên chỉ thấy giải thích sau khi kết thúc bài thi.</div></div><div class="form-actions"><button class="btn btn-primary">Lưu câu hỏi</button><a href="/admin/questions" class="btn btn-outline-secondary">Hủy</a></div></form>
<%- include('../partials/foot') %>
