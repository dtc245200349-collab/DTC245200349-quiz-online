<%- include('../partials/head') %>
<div class="page-heading"><div><span class="eyebrow">THEO DÕI CHẤT LƯỢNG HỌC TẬP</span><h1>Kết quả & thống kê</h1><p>Tra cứu bài thi và xem chi tiết từng câu trả lời.</p></div></div>
<div class="stats-grid"><div class="stat-card"><span>Tổng lượt thi</span><strong><%= stats.total %></strong></div><div class="stat-card"><span>Đã hoàn thành</span><strong><%= stats.completed %></strong></div><div class="stat-card accent"><span>Điểm trung bình</span><strong><%= scoreText(stats.average) %><small>/ 10</small></strong></div><div class="stat-card"><span>Bài đạt từ 5 điểm</span><strong><%= stats.passed %></strong></div></div>
<form class="filter-bar panel mb-4"><div><label class="form-label" for="exam_id">Đề thi</label><select class="form-select" name="exam_id" id="exam_id"><option value="">Tất cả đề thi</option><% for (const e of exams) { %><option value="<%= e.id %>" <%= examId === e.id ? 'selected' : '' %>><%= e.title %></option><% } %></select></div><div><label class="form-label" for="q">Sinh viên</label><input class="form-control" id="q" name="q" value="<%= q %>" placeholder="Tên hoặc email"></div><% if (studentId) { %><input type="hidden" name="student_id" value="<%= studentId %>"><span class="text-secondary">Đang lọc sinh viên #<%= studentId %></span><% } %><button class="btn btn-primary">Lọc kết quả</button><a class="btn btn-outline-secondary" href="/admin/results">Đặt lại</a></form>
<section class="panel table-panel"><div class="table-responsive"><table class="table"><thead><tr><th>Sinh viên</th><th>Đề thi</th><th>Bắt đầu</th><th>Trạng thái</th><th>Điểm / 10</th><th></th></tr></thead><tbody><% for (const a of attempts) { %><tr><td><strong><%= a.name %></strong><small class="cell-subtitle"><%= a.email %></small></td><td class="table-title"><%= a.exam_title %></td><td><%= formatDate(a.started_at) %></td><td><span class="badge-soft <%= a.status === 'in_progress' ? 'warning' : '' %>"><%= statusText(a.status) %></span></td><td class="score"><%= scoreText(a.score) %></td><td><% if (a.status !== 'in_progress') { %><a href="/admin/results/<%= a.id %>">Chi tiết</a><% } %></td></tr><% } %></tbody></table></div><% if (!attempts.length) { %><%- include('../partials/empty', {heading:'Chưa có kết quả phù hợp',description:'Điều chỉnh bộ lọc hoặc chờ sinh viên hoàn thành bài thi.'}) %><% } %></section>
<nav class="pagination-bar" aria-label="Phân trang"><% const suffix = '&exam_id='+(examId || '')+'&student_id='+(studentId || '')+'&q='+encodeURIComponent(q); %><% if (page > 1) { %><a class="btn btn-outline-secondary" href="?page=<%= page-1 %><%= suffix %>">Trang trước</a><% } %><span>Trang <%= page %> / <%= Math.max(1, Math.ceil(stats.total/20)) %></span><% if (page*20 < stats.total) { %><a class="btn btn-outline-secondary" href="?page=<%= page+1 %><%= suffix %>">Trang sau</a><% } %></nav>
<%- include('../partials/foot') %>
