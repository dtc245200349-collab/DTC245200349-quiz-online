<%- include('../partials/head') %>
<div class="page-heading"><div><span class="eyebrow">NỘI DUNG HỌC TẬP</span><h1>Ngân hàng câu hỏi</h1><p>Quản lý câu hỏi, phương án và giải thích đáp án.</p></div><a class="btn btn-primary" href="/admin/questions/new">+ Thêm câu hỏi</a></div>
<div class="section-toolbar"><h2>Tất cả câu hỏi <span class="count-badge"><%= total %></span></h2><form class="search-form"><label for="q" class="visually-hidden">Tìm câu hỏi</label><input class="form-control" id="q" name="q" value="<%= q %>" placeholder="Nội dung hoặc chủ đề…"><button class="btn btn-outline-primary">Tìm kiếm</button></form></div>
<section class="panel table-panel"><div class="table-responsive"><table class="table"><thead><tr><th>Mã</th><th>Nội dung</th><th>Chủ đề</th><th>Đáp án</th><th>Thao tác</th></tr></thead><tbody><% for (const question of questions) { %><tr><td class="text-secondary">#<%= question.id %></td><td class="question-cell"><%= question.content %></td><td><span class="category-tag"><%= question.category %></span></td><td><span class="answer-badge"><%= question.correct_option %></span></td><td><div class="table-actions"><a class="btn btn-sm btn-outline-primary" href="/admin/questions/<%= question.id %>/edit">Sửa</a><form action="/admin/questions/<%= question.id %>/delete" method="post" data-confirm="Xóa câu hỏi này khỏi ngân hàng?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-outline-danger">Xóa</button></form></div></td></tr><% } %></tbody></table></div><% if (!questions.length) { %><%- include('../partials/empty', {heading:'Chưa có câu hỏi phù hợp',description:'Thêm câu hỏi mới hoặc thử từ khóa khác.'}) %><% } %></section>
<nav class="pagination-bar" aria-label="Phân trang"><% if (page > 1) { %><a class="btn btn-outline-secondary" href="?q=<%= encodeURIComponent(q) %>&page=<%= page-1 %>">Trang trước</a><% } %><span>Trang <%= page %> / <%= Math.max(1,Math.ceil(total/15)) %></span><% if (page*15 < total) { %><a class="btn btn-outline-secondary" href="?q=<%= encodeURIComponent(q) %>&page=<%= page+1 %>">Trang sau</a><% } %></nav>
<%- include('../partials/foot') %>
