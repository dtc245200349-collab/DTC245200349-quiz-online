<%- include('../partials/head') %>
<div class="page-heading"><div><span class="eyebrow">KHÔNG GIAN QUẢN TRỊ</span><h1>Tổng quan hệ thống</h1><p>Theo dõi hoạt động thi và kết quả học tập tại một nơi.</p></div><a class="btn btn-primary" href="/admin/exams/new">+ Tạo đề thi</a></div>
<div class="stats-grid"><div class="stat-card"><span>Người dùng</span><strong><%= stats.users %></strong><small><%= stats.students %> tài khoản sinh viên</small></div><div class="stat-card"><span>Đề thi</span><strong><%= stats.exams %></strong><small><%= stats.questions %> câu trong ngân hàng</small></div><div class="stat-card"><span>Bài thi đã hoàn thành</span><strong><%= stats.attempts %></strong><small>Bài đã nộp và hết giờ</small></div><div class="stat-card accent"><span>Điểm trung bình</span><strong><%= scoreText(stats.average) %><small>/ 10</small></strong><small>Trên tất cả bài hoàn thành</small></div></div>
<div class="dashboard-grid"><section class="panel table-panel"><div class="panel-heading"><h2>Hoạt động gần đây</h2><a href="/admin/results">Xem tất cả</a></div><% if (!recent.length) { %><%- include('../partials/empty', {heading:'Chưa có lượt thi',description:'Kết quả sẽ xuất hiện khi sinh viên bắt đầu làm bài.'}) %><% } else { %><div class="table-responsive"><table class="table"><thead><tr><th>Sinh viên / Đề thi</th><th>Trạng thái</th><th>Điểm</th></tr></thead><tbody><% for (const a of recent) { %><tr><td><strong><%= a.name %></strong><small class="cell-subtitle"><%= a.exam_title %></small></td><td><span class="badge-soft <%= a.status === 'in_progress' ? 'warning' : '' %>"><%= statusText(a.status) %></span></td><td><% if (a.status !== 'in_progress') { %><a class="score" href="/admin/results/<%= a.id %>"><%= scoreText(a.score) %></a><% } else { %>—<% } %></td></tr><% } %></tbody></table></div><% } %></section><section class="panel"><h2>Phân bố điểm số</h2><p class="text-secondary small">Số bài thi theo khoảng điểm</p><div class="distribution"><% for (const [key,label] of [['excellent','9 – 10 điểm'],['good','7 – dưới 9'],['medium','5 – dưới 7'],['low','Dưới 5 điểm']]) { %><div class="distribution-row"><div><span><%= label %></span><strong><%= distribution[key] %></strong></div><meter min="0" max="<%= Math.max(1, stats.attempts) %>" value="<%= distribution[key] %>" aria-label="<%= label %>"></meter></div><% } %></div><div class="info-note mt-4">Điểm tính theo thang 10. Mốc đạt trong thống kê là 5 điểm.</div></section></div>
<section class="quick-actions"><a href="/admin/questions/new"><span class="quick-icon">+</span><div><strong>Thêm câu hỏi</strong><small>Bổ sung ngân hàng kiến thức</small></div></a><a href="/admin/students"><span class="quick-icon">♙</span><div><strong>Quản lý sinh viên</strong><small>Thông tin và trạng thái tài khoản</small></div></a><a href="/admin/results"><span class="quick-icon">▥</span><div><strong>Xem báo cáo điểm</strong><small>Lọc kết quả theo từng đề thi</small></div></a></section>
<%- include('../partials/foot') %>
