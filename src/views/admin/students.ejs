<%- include('../partials/head') %>
<div class="page-heading"><div><span class="eyebrow">TÀI KHOẢN & HỌC TẬP</span><h1>Quản lý sinh viên</h1><p>Cập nhật thông tin và kiểm soát quyền đăng nhập.</p></div></div>
<div class="section-toolbar"><h2>Danh sách sinh viên</h2><form class="search-form"><label class="visually-hidden" for="q">Tìm sinh viên</label><input class="form-control" id="q" name="q" value="<%= q %>" placeholder="Họ tên hoặc email…"><button class="btn btn-outline-primary">Tìm kiếm</button></form></div>
<section class="panel table-panel"><div class="table-responsive"><table class="table"><thead><tr><th>Sinh viên</th><th>Bài đã nộp</th><th>Điểm TB</th><th>Trạng thái</th><th>Quản lý</th></tr></thead><tbody><% for (const s of students) { %><tr><td><strong><%= s.name %></strong><small class="cell-subtitle"><%= s.email %></small></td><td><%= s.attempts %></td><td class="score"><%= scoreText(s.average) %></td><td><span class="badge-soft <%= s.active ? '' : 'danger' %>"><%= s.active ? 'Hoạt động' : 'Đã khóa' %></span></td><td><a href="/admin/results?student_id=<%= s.id %>">Kết quả</a><details class="inline-details"><summary>Chỉnh sửa</summary><form action="/admin/students/<%= s.id %>/update" method="post" class="edit-student"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label" for="name-<%= s.id %>">Họ tên</label><input class="form-control mb-2" id="name-<%= s.id %>" name="name" value="<%= s.name %>" minlength="2" maxlength="100" required><label class="form-label" for="email-<%= s.id %>">Email</label><input class="form-control mb-2" id="email-<%= s.id %>" name="email" type="email" value="<%= s.email %>" maxlength="190" required><label class="form-label" for="active-<%= s.id %>">Trạng thái</label><select class="form-select mb-3" id="active-<%= s.id %>" name="active"><option value="1" <%= s.active ? 'selected' : '' %>>Hoạt động</option><option value="0" <%= !s.active ? 'selected' : '' %>>Khóa tài khoản</option></select><button class="btn btn-primary btn-sm">Lưu thay đổi</button></form></details></td></tr><% } %></tbody></table></div><% if (!students.length) { %><%- include('../partials/empty', {heading:'Không tìm thấy sinh viên',description:'Thử một từ khóa khác.'}) %><% } %></section><p class="text-secondary small mt-3">Hiển thị tối đa 200 tài khoản phù hợp. Dùng tìm kiếm để thu hẹp kết quả. Khóa tài khoản giữ lại toàn bộ lịch sử thi.</p>
<%- include('../partials/foot') %>
