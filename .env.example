NODE_ENV=development
PORT=3000
# Docker exposes only these localhost ports. Node and MySQL remain internal.
NGINX_PORT=8080
PHPMYADMIN_PORT=8081
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=quiz_online
DB_USER=quiz_app
# Generate secrets with npm.cmd run setup:env. Never commit .env.
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
SESSION_SECRET=
# Set true only behind HTTPS; false permits the localhost Docker demo.
COOKIE_SECURE=false
TRUST_PROXY=0
SEED_ADMIN_EMAIL=admin@quiz.local
SEED_ADMIN_PASSWORD=
SEED_STUDENT_EMAIL=student@quiz.local
SEED_STUDENT_PASSWORD=
